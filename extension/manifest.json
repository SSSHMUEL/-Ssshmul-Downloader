{
  "manifest_version": 3,
  "name": "Ssshmul Downloader",
  "version": "1.0.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "cookies",
    "webRequest",
    "downloads",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "youtube.js"
      ],
      "all_frames": true
    }
  ],
  "key": "",
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon_mini.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}